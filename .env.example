# ── Auth (Kimi OAuth) ────────────────────────────────────────────
APP_ID=                   # Your Kimi OAuth App ID
APP_SECRET=               # Your Kimi OAuth App Secret
REFRESH_SECRET=           # Optional — defaults to APP_SECRET if not set

KIMI_AUTH_URL=            # Kimi OAuth server URL  e.g. https://auth.kimi.moonshot.cn
KIMI_OPEN_URL=            # Kimi Open Platform URL  e.g. https://api.moonshot.cn

# ── Database (MySQL / PlanetScale) ───────────────────────────────
DATABASE_URL=             # mysql://user:password@host:3306/dbname

# ── App ──────────────────────────────────────────────────────────
APP_URL=                  # http://localhost:3000
ALLOWED_ORIGINS=          # Comma-separated CORS origins  e.g. http://localhost:5173
OWNER_UNION_ID=           # Kimi union_id of the first admin user

# ── Frontend (Vite — must be prefixed VITE_) ─────────────────────
VITE_KIMI_AUTH_URL=       # Same as KIMI_AUTH_URL above
VITE_APP_ID=              # Same as APP_ID above

# ── Optional ─────────────────────────────────────────────────────
LOG_LEVEL=info            # info | debug | warn | error
